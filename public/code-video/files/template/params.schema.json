{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-video-demo/dot-notebook-step-sequence/params",
  "title": "点阵手账步骤讲解参数",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "items", "conclusion", "durationSeconds"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "note"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "note": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18
            }
          }
        }
      }
    },
    "conclusion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 10,
      "maximum": 40
    }
  }
}
